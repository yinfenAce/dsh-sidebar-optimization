{
  "name": "dsh-sidebar-optimization",
  "version": "0.1.0",
  "description": "Sidebar optimization for DSHBox / DeepSeek Harness: adjustable 45-80% sidebar, a settings card with live preview, copy fixes, view-switch animation.",
  "license": "MIT",
  "type": "commonjs",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/yinfenAce/dsh-sidebar-optimization.git"
  },
  "homepage": "https://github.com/yinfenAce/dsh-sidebar-optimization",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "mobile",
    "sidebar",
    "dshbox"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.3 <0.2.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout"
      ],
      "platform": "web"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.1-rc.5": "compatible"
      }
    }
  }
}
