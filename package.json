{
  "name": "dsh-sidebar-optimization",
  "version": "0.3.13",
  "description": "DSHBox 移动端界面优化：侧栏宽度与左右布局、余额隐私与预警、可拖动菜单、代码复制、键盘跟随等。",
  "license": "MIT",
  "type": "commonjs",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "locale",
    "index.d.ts",
    "docs"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/yinfenAce/dsh-sidebar-optimization.git"
  },
  "homepage": "https://github.com/yinfenAce/dsh-sidebar-optimization",
  "keywords": [
    "dsh",
    "dshbox",
    "deepseek-harness",
    "mobile",
    "sidebar",
    "plugin"
  ],
  "engines": {
    "dsh": ">=0.2.0-rc.2 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout"
      ],
      "platform": "web"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.1-rc.5": "compatible"
      }
    }
  },
  "types": "index.d.ts",
  "scripts": {
    "test": "node --test",
    "check": "node --check lib/client.js && node --check lib/index.js"
  }
}
